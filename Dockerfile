# 1. מתחילים ממערכת הפעלה לינוקס רזה עם פייתון 3.11 מותקן
FROM python:3.11-slim

# 2. מגדירים את תיקיית העבודה בתוך הקונטיינר
WORKDIR /code

# 3. מעתיקים קודם כל רק את קובץ הספריות (כדי לייעל את הבנייה)
COPY requirements.txt .

# 4. מתקינים את כל הספריות בלי לשמור קבצי מטמון מיותרים
RUN pip install --no-cache-dir -r requirements.txt

# 5. מעתיקים את כל שאר הפרויקט לתוך הקונטיינר (כולל תיקיית app, token.json וכו')
COPY . .

# 6. מודיעים לשרת באיזה פורט אנחנו משתמשים
EXPOSE 8000

# 7. הפקודה שתרוץ כשהקונטיינר יעלה
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]